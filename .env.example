# Copiar a .env y completar con valores locales. El .env NUNCA se comitea.

# Postgres local (PostgreSQL 16). Reemplazar USUARIO y CLAVE por los tuyos.
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/plataforma_id?schema=public"

# Secretos de JWT: generar dos cadenas aleatorias distintas y largas.
# En PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_ACCESS_SECRET="cambiar-por-cadena-aleatoria-larga"
JWT_REFRESH_SECRET="cambiar-por-otra-cadena-aleatoria-larga"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Origen del front para CORS
FRONTEND_URL="http://localhost:4300"

PORT=3000
NODE_ENV=development

# Clave del administrador inicial que crea el seed. OBLIGATORIA: minimo 10
# caracteres. El seed falla sin ella y no inventa contrasenas.
SEED_ADMIN_PASSWORD=""

# --- Motor de IA (borrador de proyecto desde documento) ---
# ADVERTENCIA: el texto extraido del documento se envia a un tercero (Google).
# En la capa gratuita, sus terminos permiten usar el contenido para mejorar sus
# productos. Requiere aval de gobierno de datos antes de produccion.
AI_PROVIDER="gemini"          # gemini | ninguno   (ninguno = apagado, responde 503)
AI_TIMEOUT_MS="30000"
AI_MAX_CARACTERES="24000"
AI_MAX_PAGINAS_PDF="40"

# AI Studio. Capa gratuita. Jamas en el front: quedaria expuesta en el bundle.
# Mientras este vacia, /ai/borrador-proyecto responde 503.
GEMINI_API_KEY=""
# Configurable y nunca hardcodeado: la oferta de modelos de la capa gratuita
# cambio dos veces en el ultimo ano. Confirmar el id en AI Studio con la key.
GEMINI_MODEL="gemini-3.5-flash-lite"
# Base override: permite pasar de v1beta a v1 sin tocar codigo.
GEMINI_API_URL="https://generativelanguage.googleapis.com/v1beta"

# Reservado para el segundo proveedor (ver AI_PROVIDER).
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Correo corporativo por Microsoft Graph ---
# Registrar la app en Entra ID con permiso de APLICACION Mail.Send y consentimiento
# de admin. Acotar el remitente con New-ApplicationAccessPolicy.
# Mientras esten vacias, los avisos quedan en estado 'pendiente' (no se pierden).
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
MAIL_FROM=""

# Base publica del front, para el boton "Ver la asignacion" del correo.
APP_URL="http://localhost:4300"
