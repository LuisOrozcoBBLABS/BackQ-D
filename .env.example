# Copiar a .env y completar con valores locales. El .env NUNCA se comitea.

# Postgres local (PostgreSQL 16). Reemplazar USUARIO y CLAVE por los tuyos.
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/plataforma_id?schema=public"

# Secretos de JWT: generar dos cadenas aleatorias distintas y largas.
# En PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_ACCESS_SECRET="cambiar-por-cadena-aleatoria-larga"
JWT_REFRESH_SECRET="cambiar-por-otra-cadena-aleatoria-larga"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Origen del front para CORS
FRONTEND_URL="http://localhost:4300"

PORT=3000
NODE_ENV=development

# Fase 2 (motor de IA). Todavía no se usa; la key va aquí, jamás en el front.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# --- Correo corporativo por Microsoft Graph ---
# Registrar la app en Entra ID con permiso de APLICACION Mail.Send y consentimiento
# de admin. Acotar el remitente con New-ApplicationAccessPolicy.
# Mientras esten vacias, los avisos quedan en estado 'pendiente' (no se pierden).
AZURE_TENANT_ID=""
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
MAIL_FROM=""

# Base publica del front, para el boton "Ver la asignacion" del correo.
APP_URL="http://localhost:4300"
